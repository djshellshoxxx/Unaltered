# Supply-chain hardening. See docs/OPSEC.md section 3.
# Never run dependency install scripts automatically.
ignore-scripts=true
# Record exact versions, never ranges.
save-exact=true
# Fail on unsupported Node versions rather than building on an unknown toolchain.
engine-strict=true
# Do not nag or phone home.
fund=false
update-notifier=false
# Do not auto-install peer dependencies (only what package.json lists is installed;
# also avoids an npm arborist crash on optional vite devtools peers).
legacy-peer-deps=true
