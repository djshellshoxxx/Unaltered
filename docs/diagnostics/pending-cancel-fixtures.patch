+// A backend can provide every known byte without completing its cleanup promise.
+// This fixture exercises cleanup robustness; it does not identify a native browser stall's cause.
+function pendingCancelBlob(size: number, partialReads = false) {
+  const bytes = Uint8Array.from({ length: size }, (_, i) => i + 1);
+  const blob = new Blob([bytes]);
+  const slice = blob.slice.bind(blob);
+  const ranges: number[][] = [];
+  const streams: ReadableStream<Uint8Array>[] = [];
+  let cancelCalls = 0;
+  const pendingCancel = new Promise<void>(() => {});
+  blob.stream = (): never => { throw new Error('unexpected whole-file stream'); };
+  blob.slice = (start = 0, end = blob.size): Blob => {
+    ranges.push([start, end]);
+    const part = slice(start, end);
+    const payload = bytes.subarray(start, end);
+    let offset = 0;
+    const stream = new ReadableStream({
+      type: 'bytes',
+      pull(controller) {
+        // An extra EOF read must not be needed after the known slice length was consumed.
+        if (offset === payload.length) return new Promise<void>(() => {});
+        const request = controller.byobRequest;
+        if (!request?.view) throw new Error('expected a BYOB request');
+        const view = new Uint8Array(request.view.buffer, request.view.byteOffset, request.view.byteLength);
+        const length = Math.min(view.length, payload.length - offset, partialReads ? 1 : payload.length);
+        view.set(payload.subarray(offset, offset + length));
+        offset += length;
+        request.respond(length);
+      },
+      cancel() {
+        cancelCalls++;
+        return pendingCancel; // Deliberately never settles, even after all bytes were delivered.
+      },
+    });
+    if (partialReads) {
+      const getReader = stream.getReader.bind(stream);
+      Object.defineProperty(stream, 'getReader', { value: () => {
+        const reader = getReader({ mode: 'byob' });
+        const read = reader.read.bind(reader);
+        // Simulate engines that return short BYOB reads without implementing the min option.
+        Object.defineProperty(reader, 'read', { value: (view: Uint8Array<ArrayBuffer>) => read(view, { min: 1 }) });
+        return reader;
+      } });
+    }
+    streams.push(stream);
+    part.stream = () => stream;
+    part.arrayBuffer = async (): Promise<ArrayBuffer> => { throw new Error('unexpected allocated slice read'); };
+    return part;
+  };
+  return { blob, bytes, ranges, streams, cancelCalls: () => cancelCalls };
+}
+
+async function cleanupWatchdog<T>(work: Promise<T>, state: () => string): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    return await Promise.race([work, new Promise<never>((_, reject) => {
+      timer = setTimeout(() => reject(new Error(`Cleanup fixture did not settle within 1000 ms: ${state()}`)), 1000);
+    })]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+describe('bounded Blob reader cleanup with pending cancellation', () => {
+  for (const [name, size, partialReads] of [
+    ['consumed multiple slices', 7, false],
+    ['consumed final slice', 3, false],
+    ['partial reads across slices', 7, true],
+  ] as const) {
+    it(name, async () => {
+      const fixture = pendingCancelBlob(size, partialReads);
+      const progress: number[] = [];
+      const result = await cleanupWatchdog(hashSource(fixture.blob, {
+        chunkSize: 3,
+        onProgress: (done) => progress.push(done),
+      }), () => `progress=${progress.join(',')}; cancelCalls=${fixture.cancelCalls()}; slices=${JSON.stringify(fixture.ranges)}`);
+      expect(result?.hex).toBe(createHash('sha256').update(fixture.bytes).digest('hex'));
+      expect(result?.bytes).toBe(size);
+      expect(fixture.ranges).toEqual(size === 3 ? [[0, 3]] : [[0, 3], [3, 6], [6, 7]]);
+      expect(progress).toEqual(partialReads ? [1, 2, 3, 4, 5, 6, 7] : size === 3 ? [3] : [3, 6, 7]);
+      expect(fixture.streams.every((stream) => !stream.locked)).toBe(true);
+    });
+  }
+
+  it('onProgress cancellation settles and releases the consumed slice', async () => {
+    const fixture = pendingCancelBlob(7);
+    let cancelled = false;
+    const result = await cleanupWatchdog(hashSource(fixture.blob, {
+      chunkSize: 3,
+      isCancelled: () => cancelled,
+      onProgress: () => { cancelled = true; },
+    }), () => `cancelled=${cancelled}; cancelCalls=${fixture.cancelCalls()}; slices=${JSON.stringify(fixture.ranges)}`);
+    expect(result).toBeNull();
+    expect(fixture.ranges).toEqual([[0, 3]]);
+    expect(fixture.streams.every((stream) => !stream.locked)).toBe(true);
+  });
+});
