+    def test_smallest_vector_is_the_hand_assembled_frame(self) -> None:
+        smallest = self.committed["valid"][0]
+        self.assertEqual(smallest["name"], "smallest-receipt-single-frame")
+        self.assertEqual(smallest["receipt"], {"hex": "00"})
+        self.assertEqual(smallest["frames"], [HAND_ASSEMBLED_SMALLEST_FRAME])
+        self.assertEqual(len(bytes.fromhex(HAND_ASSEMBLED_SMALLEST_FRAME)), 81)
+
+    def test_stream_receipts_follow_the_documented_rule(self) -> None:
+        # Both blocks were computed with coreutils:
+        #   printf 'UNALTERED-OTS-QR/1 independent vector last-frame-shorter\0\0\0\0' | sha256sum
+        #   printf 'UNALTERED-OTS-QR/1 independent vector last-frame-shorter\0\0\0\1' | sha256sum
+        expected = (
+            "f31bf905d972c12ee2601ef2a33f531eef9eecd5af78c6f6c6efc01932abaa7a"
+            "c2582cd626dab26b11427ff8d6ddbed3d3df1835a8f73188360cb30bcf21ab0d"
+        )
+        self.assertEqual(builder.stream("last-frame-shorter", 64).hex(), expected)
+        self.assertEqual(builder.stream("last-frame-shorter", 33).hex(), expected[:66])
+        self.assertEqual(builder.stream("last-frame-shorter", 0), b"")
+
+    def test_vector_names_are_unique(self) -> None:
+        kinds = ("valid", "invalid", "unspecified")
+        names = [entry["name"] for kind in kinds for entry in self.committed[kind]]
+        self.assertEqual(len(names), len(set(names)))
+
+
+class ValidVectorsFollowTheHeaderTable(unittest.TestCase):
+    """Read every valid frame at the table's fixed offsets and check each rule of the table."""
+
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.committed = committed_document()
+
+    def check_set(self, entry: dict) -> None:
+        receipt = builder.receipt_from(entry["receipt"])
+        frames = builder.frames_of(entry)
+        label = "UNALTERED-OTS-QR/1".encode("utf-8")
+        expected_proof = hashlib.sha256(label + b"\x00" + receipt).digest()[:16]
+        expected_digest = hashlib.sha256(receipt).digest()
+        self.assertEqual(entry["receiptLength"], len(receipt))
+        self.assertEqual(entry["receiptSha256"], expected_digest.hex())
+        self.assertEqual(entry["proofId"], expected_proof.hex())
+        self.assertEqual(entry["frameCount"], len(frames))
+        self.assertTrue(1 <= len(frames) <= 4096)
+        self.assertTrue(1 <= len(receipt) <= 16_777_216)
+
+        running = hashlib.sha256()
+        carried = bytearray()
+        for position, frame in enumerate(frames):
+            running.update(frame)
+            self.assertGreater(len(frame), 80)
+            self.assertEqual(frame[0:8], b"UOTSQR01")
+            self.assertEqual(frame[8], 1)
+            self.assertEqual(frame[9], 0)
+            self.assertEqual(frame[10], 0)
+            self.assertEqual(frame[11], 0)
+            self.assertEqual(frame[12:28], expected_proof)
+            self.assertEqual(int.from_bytes(frame[28:32], "big"), position)
+            self.assertEqual(int.from_bytes(frame[32:36], "big"), len(frames))
+            self.assertEqual(int.from_bytes(frame[36:40], "big"), len(receipt))
+            self.assertEqual(int.from_bytes(frame[40:44], "big"), len(receipt))
+            self.assertEqual(frame[44:76], expected_digest)
+            self.assertEqual(int.from_bytes(frame[76:80], "big"), len(frame) - 80)
+            carried += frame[80:]
+        self.assertEqual(bytes(carried), receipt)
+        self.assertEqual(entry["framesSha256"], running.hexdigest())
+        self.assertEqual(entry["framesBytes"], sum(len(frame) for frame in frames))
+        self.assertEqual([len(frame) - 80 for frame in frames], builder.expand_slices(entry["slices"]))
+        if "frames" not in entry:
+            self.assertEqual(entry["firstHeader"], frames[0][:80].hex())
+            self.assertEqual(entry["lastHeader"], frames[-1][:80].hex())
+
+    def test_every_valid_set(self) -> None:
+        self.assertGreaterEqual(len(self.committed["valid"]), 10)
+        for entry in self.committed["valid"]:
+            with self.subTest(vector=entry["name"]):
+                self.check_set(entry)
+
+    def test_sets_with_frames_beyond_one_qr_symbol_follow_the_table_too(self) -> None:
+        # These two are listed as unspecified only because a frame is longer than one QR symbol holds.
+        recipes = [entry for entry in self.committed["unspecified"] if "slices" in entry]
+        self.assertEqual([entry["name"] for entry in recipes], ["frame-2954-bytes", "original-length-16777216"])
+        for entry in recipes:
+            with self.subTest(vector=entry["name"]):
+                self.check_set(entry)
+                self.assertGreater(max(builder.expand_slices(entry["slices"])) + 80, 2953)
+
+    def test_named_boundaries_are_present(self) -> None:
+        by_name = {entry["name"]: entry for entry in self.committed["valid"]}
+        self.assertEqual(by_name["smallest-receipt-single-frame"]["receiptLength"], 1)
+        self.assertEqual(by_name["smallest-receipt-single-frame"]["frameCount"], 1)
+        self.assertEqual(by_name["frame-count-4096"]["frameCount"], 4096)
+        # Last header of the 4096-frame set: index 4095 (0x00000fff) of 4096 (0x00001000).
+        self.assertEqual(by_name["frame-count-4096"]["lastHeader"][56:72], "00000fff00001000")
+        self.assertEqual(by_name["largest-qr-symbol-frames"]["slices"][0], [2, 2953 - 80])
+        self.assertEqual(by_name["largest-receipt-in-qr-symbols"]["receiptLength"], 4096 * (2953 - 80))
+        self.assertEqual(by_name["largest-receipt-in-qr-symbols"]["slices"], [[4096, 2953 - 80]])
+        # The upper bound the table names for the original byte length needs frames of 4176 bytes.
+        unspecified = {entry["name"]: entry for entry in self.committed["unspecified"]}
+        largest = unspecified["original-length-16777216"]
+        self.assertEqual(largest["receiptLength"], 16_777_216)
+        self.assertEqual(largest["frameCount"], 4096)
+        # Original and encoded byte length 16,777,216 = 0x01000000.
+        self.assertEqual(largest["firstHeader"][72:88], "0100000001000000")
+
+
+class BuilderRefusesRuleViolations(unittest.TestCase):
+    """build_frames produces valid sets only; assemble and raw_frame build the invalid ones."""
+
+    def test_limits(self) -> None:
+        for receipt, sizes in (
+            (b"", []),
+            (b"", [0]),
+            (b"ab", [2, 0]),
+            (b"ab", [1]),
+            (b"ab", [1, 2]),
+            (b"a" * 4097, [1] * 4097),
+            (bytes(16_777_217), [16_777_217]),
+        ):
+            with self.subTest(length=len(receipt), frames=len(sizes)):
+                with self.assertRaises(ValueError):
+                    builder.build_frames(receipt, sizes)
+
+    def test_uniform_sizes(self) -> None:
+        self.assertEqual(builder.uniform_sizes(250, 100), [100, 100, 50])
+        self.assertEqual(builder.uniform_sizes(300, 100), [100, 100, 100])
+        self.assertEqual(builder.uniform_sizes(1, 100), [1])
+
+
+def arrangements(frames: list) -> dict:
+    """The same set in index order, reversed, and with odd indices first."""
+    return {"index order": frames, "reversed": frames[::-1], "odd indices first": frames[1::2] + frames[0::2]}
+
+
+class ReferenceRecoveryAgainstIndependentVectors(unittest.TestCase):
+    """scripts/recover-archival-qr.py must treat the independently built frames as the text says."""
+
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.reference = load_reference()
+        cls.committed = committed_document()
+
+    def test_the_two_vector_sets_agree(self) -> None:
+        # golden-v1.hex is the first, shared vector. The independent builder produces the same frame.
+        lines = (ROOT / "tests" / "archival" / "golden-v1.hex").read_text(encoding="ascii").splitlines()
+        first_vector = bytes.fromhex("".join(line for line in lines if not line.startswith("#")))
+        receipt = bytes([0x00, 0xFF, 0x01, 0x80, 0x2A, 0x0A])
+        self.assertEqual(builder.build_frames(receipt, [len(receipt)]), [first_vector])
+
+    def test_valid_sets_recover_the_exact_receipt(self) -> None:
+        for entry in self.committed["valid"]:
+            receipt = builder.receipt_from(entry["receipt"])
+            frames = builder.frames_of(entry)
+            for label, arrangement in arrangements(frames).items():
+                with self.subTest(vector=entry["name"], order=label):
+                    self.assertEqual(self.reference.recover(arrangement), receipt)
+
+    def test_identical_duplicates_are_ignored(self) -> None:
+        # "Identical duplicate frames may be ignored." Sets of 4096 frames are left out here: one more
+        # input exceeds the number of payloads both implementations accept (see the next test).
+        for entry in self.committed["valid"]:
+            frames = builder.frames_of(entry)
+            if len(frames) >= 4096:
+                continue
+            with self.subTest(vector=entry["name"]):
+                receipt = builder.receipt_from(entry["receipt"])
+                self.assertEqual(self.reference.recover(frames + frames[:1]), receipt)
+                self.assertEqual(self.reference.recover(frames[-1:] + frames + frames), receipt)
+
+    def test_a_duplicate_next_to_4096_frames_never_yields_other_bytes(self) -> None:
+        # The text bounds the frame count field, not the number of scanned payloads. Whether 4097 inputs
+        # (a complete 4096-frame set and one identical duplicate) are accepted is not specified.
+        entry = next(entry for entry in self.committed["valid"] if entry["name"] == "frame-count-4096")
+        frames = builder.frames_of(entry)
+        try:
+            recovered = self.reference.recover(frames + frames[:1])
+        except ValueError:
+            return
+        self.assertEqual(recovered, builder.receipt_from(entry["receipt"]))
+
+    def test_invalid_sets_are_rejected(self) -> None:
+        self.assertGreaterEqual(len(self.committed["invalid"]), 30)
+        for entry in self.committed["invalid"]:
+            frames = builder.frames_of(entry)
+            for label, arrangement in arrangements(frames).items():
+                with self.subTest(vector=entry["name"], order=label, rule=entry["rule"]):
+                    with self.assertRaises(ValueError):
+                        self.reference.recover(arrangement)
+
+    def test_unspecified_inputs_never_yield_other_bytes(self) -> None:
+        for entry in self.committed["unspecified"]:
+            frames = builder.frames_of(entry)
+            acceptable = builder.acceptable_receipts(entry)
+            for label, arrangement in arrangements(frames).items():
+                with self.subTest(vector=entry["name"], order=label):
+                    try:
+                        recovered = self.reference.recover(arrangement)
+                    except ValueError:
+                        continue
+                    self.assertIn(recovered, acceptable)
+
+    def test_documented_command_line_recovers_a_multi_frame_vector(self) -> None:
+        entry = next(entry for entry in self.committed["valid"] if entry["name"] == "ots-shaped-three-frames")
+        frames = builder.frames_of(entry)
+        with tempfile.TemporaryDirectory() as directory:
+            paths = []
+            for index, frame in enumerate(frames):
+                path = Path(directory) / f"frame-{index:03}.bin"
+                path.write_bytes(frame)
+                paths.append(str(path))
+            output = Path(directory) / "recovered.ots"
+            command = [sys.executable, str(REFERENCE_SCRIPT), *reversed(paths), "-o", str(output)]
+            completed = subprocess.run(command, capture_output=True, text=True, timeout=120, check=False)
+            self.assertEqual(completed.returncode, 0, completed.stderr)
+            self.assertEqual(output.read_bytes(), builder.receipt_from(entry["receipt"]))
+            self.assertIn(entry["receiptSha256"], completed.stdout)
+
