+
+    const capacity = greedyCapacity(sizesOf(entry.slices));
+    if (capacity === null) {
+      it(`cannot encode the partition of ${entry.name}, which only a decoder has to accept`, () => {
+        expect(entry.name).toBe('uneven-partition');
+      });
+      continue;
+    }
