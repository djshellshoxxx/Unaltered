+describe('independent golden vectors: where this implementation is stricter than the frame table', () => {
+  // Finding, pinned so that a change on either side is noticed. The frame table and the resource bounds of
+  // docs/ARCHIVAL_QR_PROTOCOL.md name no frame size limit, and give 16,777,216 as the upper bound of the original
+  // byte length. This implementation and the Python reference recovery refuse frames longer than 2953 bytes (one
+  // QR byte-mode symbol), so 4096 frames carry at most 4096 * 2873 = 11,767,808 bytes.
+  const largest = vectors.valid.find(entry => entry.name === 'largest-receipt-in-qr-symbols')!;
+  const beyond = vectors.unspecified.filter(isRecipe);
+
+  it('accepts a frame of 2953 bytes and refuses a frame of 2954 bytes', async () => {
+    const atLimit = vectors.valid.find(entry => entry.name === 'largest-qr-symbol-frames')!;
+    expect(Math.max(...sizesOf(atLimit.slices)) + HEADER).toBe(QR_SYMBOL_BYTES);
+    expect(same(await recoverReceiptFrames(framesOf(atLimit)), receiptOf(atLimit.receipt))).toBe(true);
+    const over = beyond.find(entry => entry.name === 'frame-2954-bytes')!;
+    const frames = framesOf(over);
+    expect(frames[0]!.length).toBe(QR_SYMBOL_BYTES + 1);
+    await expect(recoverReceiptFrames(frames)).rejects.toBeInstanceOf(Error);
+    await expect(encodeReceiptFrames(receiptOf(over.receipt), QR_SYMBOL_BYTES + 1)).rejects.toBeInstanceOf(Error);
+  });
+  it('cannot carry the 16,777,216 bytes the table names as the upper bound', async () => {
+    const named = beyond.find(entry => entry.name === 'original-length-16777216')!;
+    expect(named.receiptLength).toBe(16_777_216);
+    const receipt = receiptOf(named.receipt);
+    await expect(recoverReceiptFrames(framesOf(named))).rejects.toBeInstanceOf(Error);
+    // No frame capacity the encoder allows fits 16,777,216 bytes into 4096 frames.
+    await expect(encodeReceiptFrames(receipt, 4096 + HEADER)).rejects.toBeInstanceOf(Error);
+    await expect(encodeReceiptFrames(receipt, QR_SYMBOL_BYTES)).rejects.toBeInstanceOf(Error);
+  }, 120_000);
+  it('carries at most 11,767,808 bytes: one byte more is refused', async () => {
+    expect(largest.receiptLength).toBe(4096 * (QR_SYMBOL_BYTES - HEADER));
+    const oneMore = new Uint8Array(largest.receiptLength + 1);
+    oneMore.set(receiptOf(largest.receipt));
+    await expect(encodeReceiptFrames(oneMore, QR_SYMBOL_BYTES)).rejects.toBeInstanceOf(Error);
+    expect((await encodeReceiptFrames(oneMore.subarray(0, largest.receiptLength), QR_SYMBOL_BYTES)).length).toBe(4096);
+  }, 120_000);
+});
