+#!/usr/bin/env python3
+"""Independent UNALTERED-OTS-QR/1 frame builder and golden-vector generator.
+
+Written from the text of docs/ARCHIVAL_QR_PROTOCOL.md only. It shares no code with
+src/core/archive/frames.ts, scripts/recover-archival-qr.py or the frame helper in
+test_recover_reference.py, and its author had read none of them when this file and
+independent-vectors-v1.json were first committed. Agreement between this builder and those
+implementations is therefore evidence about the specification, not about a shared mistake.
+
+Standard library only.
+
+    python3 tests/archival/independent_frames.py            # print a summary of the vector set
+    python3 tests/archival/independent_frames.py --check    # compare with the committed vectors
+    python3 tests/archival/independent_frames.py --write    # regenerate the committed vectors
+
+Where the specification leaves a choice open, this file takes no choice silently: the choice is
+an explicit input (for example the partition of the receipt into slices) and is recorded in the
+vector file. Entries added or reclassified after the comparison with the implementations are
+listed in README.md; no frame byte of an earlier entry was changed.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+from typing import Iterable, Iterator, Sequence
+
+# --- The specification, section "Binary frame (80-byte fixed header)" -------------------------
+#
+# "All integers are unsigned, big-endian. All offsets below are zero-based byte offsets."
+#
+#   offset size field                 rule
+#        0    8 magic                 ASCII `UOTSQR01`
+#        8    1 version               exactly 1
+#        9    1 flags                 exactly 0 in v1
+#       10    1 compression           0 = none; future values rejected
+#       11    1 reserved              0
+#       12   16 proof ID              first 16 bytes of SHA-256(UTF-8 `UNALTERED-OTS-QR/1` + NUL +
+#                                     original receipt bytes)
+#       28    4 frame index           zero-based, less than total
+#       32    4 frame count           1-4096
+#       36    4 original byte length  1-16,777,216
+#       40    4 encoded byte length   equal to original length in v1
+#       44   32 receipt SHA-256       hash of complete original receipt bytes
+#       76    4 payload byte length   equals actual trailing byte count
+#       80    - payload               contiguous slice of original receipt
+
+MAGIC = b"UOTSQR01"
+VERSION = 1
+PROOF_ID_LABEL = "UNALTERED-OTS-QR/1"
+PROOF_ID_BYTES = 16
+HEADER_BYTES = 80
+MIN_FRAME_COUNT = 1
+MAX_FRAME_COUNT = 4096
+MIN_ORIGINAL_BYTES = 1
+MAX_ORIGINAL_BYTES = 16_777_216
+
+# Not part of the transport: ISO/IEC 18004 Model 2 byte mode holds at most 2953 bytes in one symbol
+# (version 40, level L), so no frame printed as one QR symbol can be longer than that.
+QR_BYTE_MODE_MAX_BYTES = 2953
+
+VECTOR_FILE = Path(__file__).resolve().parent / "independent-vectors-v1.json"
+SCHEMA = "unaltered-ots-qr-independent-vectors/1"
+# Frame sets up to this many bytes are stored as hex. Larger sets are stored as a recipe (receipt
+# stream, slices) with the SHA-256 of all frames concatenated in index order.
+INLINE_SET_BYTES = 2048
+
+
+def receipt_sha256(receipt: bytes) -> bytes:
+    """Offset 44: "hash of complete original receipt bytes"."""
+    return hashlib.sha256(receipt).digest()
+
+
+def proof_id(receipt: bytes) -> bytes:
+    """Offset 12: first 16 bytes of SHA-256(UTF-8 label + NUL + original receipt bytes)."""
+    preimage = PROOF_ID_LABEL.encode("utf-8") + b"\x00" + receipt
+    return hashlib.sha256(preimage).digest()[:PROOF_ID_BYTES]
+
+
+def u32(value: int) -> bytes:
+    """An unsigned, big-endian 32-bit integer."""
+    if not 0 <= value <= 0xFFFFFFFF:
+        raise ValueError(f"{value} does not fit an unsigned 32-bit field")
+    return value.to_bytes(4, "big")
+
+
+def u8(value: int) -> bytes:
+    if not 0 <= value <= 0xFF:
+        raise ValueError(f"{value} does not fit an unsigned 8-bit field")
+    return bytes([value])
+
+
+def raw_frame(
+    *,
+    proof: bytes,
+    index: int,
+    count: int,
+    original_length: int,
+    encoded_length: int,
+    digest: bytes,
+    payload_length: int,
+    trailing: bytes,
+    magic: bytes = MAGIC,
+    version: int = VERSION,
+    flags: int = 0,
+    compression: int = 0,
+    reserved: int = 0,
+) -> bytes:
+    """Lay out one frame exactly as the table says. Checks field widths only, never a rule.
+
+    Invalid vectors are built with this function, so it must not refuse rule violations.
+    """
+    if len(magic) != 8 or len(proof) != PROOF_ID_BYTES or len(digest) != 32:
+        raise ValueError("magic, proof ID and receipt SHA-256 have fixed widths of 8, 16 and 32 bytes")
+    header = b"".join(
+        (
+            magic,  # offset 0, 8 bytes
+            u8(version),  # offset 8
+            u8(flags),  # offset 9
+            u8(compression),  # offset 10
+            u8(reserved),  # offset 11
+            proof,  # offset 12, 16 bytes
+            u32(index),  # offset 28
+            u32(count),  # offset 32
+            u32(original_length),  # offset 36
+            u32(encoded_length),  # offset 40
+            digest,  # offset 44, 32 bytes
+            u32(payload_length),  # offset 76
+        )
+    )
+    if len(header) != HEADER_BYTES:
+        raise AssertionError("the fixed header is 80 bytes")
+    return header + trailing
+
+
+def expand_slices(runs: Sequence[Sequence[int]]) -> list[int]:
+    """[[repeat, size], ...] -> one size per frame, in frame order."""
+    sizes: list[int] = []
+    for repeat, size in runs:
+        sizes.extend([size] * repeat)
+    return sizes
+
+
+def assemble(receipt: bytes, sizes: Sequence[int]) -> list[bytes]:
+    """Frames for `receipt` cut into consecutive slices of the given sizes.
+
+    Every header field is derived from the receipt as the table says. No rule is checked, so the
+    same function builds sets that are well formed except for one named limit.
+    """
+    proof = proof_id(receipt)
+    digest = receipt_sha256(receipt)
+    frames: list[bytes] = []
+    offset = 0
+    for index, size in enumerate(sizes):
+        payload = receipt[offset : offset + size]
+        if len(payload) != size:
+            raise ValueError("the slices are longer than the receipt")
+        frames.append(
+            raw_frame(
+                proof=proof,
+                index=index,
+                count=len(sizes),
+                original_length=len(receipt),
+                encoded_length=len(receipt),
+                digest=digest,
+                payload_length=size,
+                trailing=payload,
+            )
+        )
+        offset += size
+    if offset != len(receipt):
+        raise ValueError("the slices do not cover the receipt")
+    return frames
+
+
+def build_frames(receipt: bytes, sizes: Sequence[int]) -> list[bytes]:
+    """A valid v1 frame set, or ValueError when the request breaks a rule of the specification.
+
+    The specification does not say how an encoder chooses slice sizes ("frames must partition the
+    original bytes into nonempty, ordered, contiguous slices"), so the caller states the partition.
+    """
+    if not MIN_ORIGINAL_BYTES <= len(receipt) <= MAX_ORIGINAL_BYTES:
+        raise ValueError("original byte length must be 1-16,777,216")
+    if not MIN_FRAME_COUNT <= len(sizes) <= MAX_FRAME_COUNT:
+        raise ValueError("frame count must be 1-4096")
+    if any(size < 1 for size in sizes):
+        raise ValueError("every slice must be nonempty")
+    if sum(sizes) != len(receipt):
+        raise ValueError("the slices must partition the receipt")
+    return assemble(receipt, sizes)
+
+
+def uniform_sizes(length: int, slice_bytes: int) -> list[int]:
+    """Equal slices with a shorter last slice when the length is not a multiple.
+
+    One possible partition, not one the specification requires.
+    """
+    full, rest = divmod(length, slice_bytes)
+    return [slice_bytes] * full + ([rest] if rest else [])
+
+
+def patch(frame: bytes, offset: int, replacement: bytes) -> bytes:
+    """A copy of `frame` with `replacement` written at `offset`."""
+    if offset + len(replacement) > len(frame):
+        raise ValueError("the replacement does not fit the frame")
+    return frame[:offset] + replacement + frame[offset + len(replacement) :]
+
+
+# --- Deterministic synthetic receipts ----------------------------------------------------------
+
+STREAM_PREFIX = "UNALTERED-OTS-QR/1 independent vector "
+STREAM_RULE = (
+    "block(k) = SHA-256(ASCII('" + STREAM_PREFIX + "' + label) || uint32be(k)); "
+    "bytes = block(0) || block(1) || ... truncated to the stated length"
+)
+
+
+def stream_blocks(label: str) -> Iterator[bytes]:
+    prefix = (STREAM_PREFIX + label).encode("ascii")
+    counter = 0
+    while True:
+        yield hashlib.sha256(prefix + u32(counter)).digest()
+        counter += 1
+
+
+def stream(label: str, length: int) -> bytes:
+    """Deterministic bytes that do not repeat, so swapped or shifted slices change the digest."""
+    blocks = stream_blocks(label)
+    parts: list[bytes] = []
+    for _ in range((length + 31) // 32):
+        parts.append(next(blocks))
+    return b"".join(parts)[:length]
+
+
+def ots_shaped_receipt() -> bytes:
+    """A small synthetic receipt with the shape of a detached OpenTimestamps file.
+
+    Header magic, major version 1, SHA-256 file-hash operation, a 32-byte digest and a single
+    pending attestation that names a reserved example host. The transport treats receipts as
+    opaque bytes; this one only makes the vectors look like the data the transport carries.
+    """
+    magic = b"\x00OpenTimestamps\x00\x00Proof\x00\xbf\x89\xe2\xe8\x84\xe8\x92\x94"
+    file_digest = hashlib.sha256(b"UNALTERED-OTS-QR/1 independent vector: synthetic file").digest()
+    uri = b"https://calendar.example"
+    attestation_payload = u8(len(uri)) + uri
+    pending = b"\x00" + bytes.fromhex("83dfe30d2ef90c8e") + u8(len(attestation_payload)) + attestation_payload
+    return magic + b"\x01" + b"\x08" + file_digest + pending
+
+
+# --- Vector definitions ------------------------------------------------------------------------
+
+
+def receipt_from(spec: dict) -> bytes:
+    """The receipt bytes a vector entry describes."""
+    if "hex" in spec:
+        return bytes.fromhex(spec["hex"])
+    return stream(spec["stream"], spec["length"])
+
+
+def frames_digest(frames: Iterable[bytes]) -> tuple[str, int]:
+    """SHA-256 of all frames concatenated in the given order, and the total byte count."""
+    state = hashlib.sha256()
+    total = 0
+    for frame in frames:
+        state.update(frame)
+        total += len(frame)
+    return state.hexdigest(), total
+
+
+def recipe_entry(name: str, text: dict, receipt_spec: dict, runs: Sequence[Sequence[int]], *, valid: bool) -> dict:
+    """A vector described by receipt and slices. Small sets also carry every frame as hex."""
+    receipt = receipt_from(receipt_spec)
+    sizes = expand_slices(runs)
+    frames = build_frames(receipt, sizes) if valid else assemble(receipt, sizes)
+    digest, total = frames_digest(frames)
+    entry: dict = {"name": name}
+    entry.update(text)
+    entry.update(
+        {
+            "receipt": receipt_spec,
+            "receiptLength": len(receipt),
+            "receiptSha256": receipt_sha256(receipt).hex(),
+            "proofId": proof_id(receipt).hex(),
+            "slices": [list(run) for run in runs],
+            "frameCount": len(frames),
+            "framesBytes": total,
+            "framesSha256": digest,
+        }
+    )
+    if total <= INLINE_SET_BYTES:
+        entry["frames"] = [frame.hex() for frame in frames]
+    else:
+        entry["firstHeader"] = frames[0][:HEADER_BYTES].hex()
+        entry["lastHeader"] = frames[-1][:HEADER_BYTES].hex()
+    return entry
+
+
