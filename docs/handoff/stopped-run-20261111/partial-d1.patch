+      const receipt = receiptOf(entry.receipt);
+      const produced = await encodeReceiptFrames(receipt, capacity + HEADER);
+      expect(produced.length).toBe(entry.frameCount);
+      expect(sha256Hex(produced)).toBe(entry.framesSha256);
+      if (entry.frames) expect(produced.map(hex)).toEqual(entry.frames);
+      else {
+        expect(hex(produced[0]!.subarray(0, HEADER))).toBe(entry.firstHeader);
+        expect(hex(produced[produced.length - 1]!.subarray(0, HEADER))).toBe(entry.lastHeader);
+      }
+    }, 120_000);
+  }
+});
