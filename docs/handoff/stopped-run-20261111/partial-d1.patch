+import { createHash } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { describe, expect, it } from 'vitest';
+import { encodeReceiptFrames, recoverReceiptFrames } from '../../src/core/archive/frames';
+
+// Second, independently constructed vector set for UNALTERED-OTS-QR/1.
+// tests/archival/independent_frames.py built every frame from the text of docs/ARCHIVAL_QR_PROTOCOL.md; its author
+// had not read this implementation when the vectors were first committed. tests/archival/test_independent_vectors.py
+// checks the same file against the Python reference recovery. tests/archival/README.md lists the differences found
+// between the specification text and the implementations.
+
+type Runs = readonly (readonly [number, number])[];
+type ReceiptSource = { hex: string } | { stream: string; length: number };
+interface Recipe {
+  name: string;
+  receipt: ReceiptSource;
+  receiptLength: number;
+  receiptSha256: string;
+  proofId: string;
+  slices: Runs;
+  frameCount: number;
+  framesBytes: number;
+  framesSha256: string;
+  frames?: string[];
+  firstHeader?: string;
+  lastHeader?: string;
+}
+interface FrameList { name: string; frames: string[] }
+type InvalidVector = (Recipe | FrameList) & { rule: string; change: string };
+type UnspecifiedInput = (Recipe | (FrameList & { acceptable: string[] })) & { question: string };
+interface VectorFile { schema: string; protocol: string; valid: Recipe[]; invalid: InvalidVector[]; unspecified: UnspecifiedInput[] }
+
+const HEADER = 80;
+/** The most one ISO/IEC 18004 Model 2 byte-mode symbol holds (version 40, level L). */
+const QR_SYMBOL_BYTES = 2953;
+const vectors = JSON.parse(readFileSync('tests/archival/independent-vectors-v1.json', 'utf8')) as VectorFile;
+
+const unhex = (text: string): Uint8Array => Uint8Array.from(Buffer.from(text, 'hex'));
+const hex = (bytes: Uint8Array): string => Buffer.from(bytes.buffer, bytes.byteOffset, bytes.byteLength).toString('hex');
+const same = (a: Uint8Array, b: Uint8Array): boolean =>
+  Buffer.from(a.buffer, a.byteOffset, a.byteLength).equals(Buffer.from(b.buffer, b.byteOffset, b.byteLength));
+function sha256Hex(parts: Iterable<Uint8Array>): string {
+  const state = createHash('sha256');
+  for (const part of parts) state.update(part);
+  return state.digest('hex');
+}
+
+/** The deterministic receipt stream of the vector file: block(k) = SHA-256(ASCII prefix + label || uint32be(k)). */
+function stream(label: string, length: number): Uint8Array {
+  const prefix = Buffer.from('UNALTERED-OTS-QR/1 independent vector ' + label, 'ascii');
+  const counter = Buffer.alloc(4);
+  const out = new Uint8Array(Math.ceil(length / 32) * 32);
+  for (let block = 0; block * 32 < length; block++) {
+    counter.writeUInt32BE(block);
+    out.set(createHash('sha256').update(prefix).update(counter).digest(), block * 32);
+  }
+  return out.slice(0, length);
+}
+const receiptOf = (source: ReceiptSource): Uint8Array => 'hex' in source ? unhex(source.hex) : stream(source.stream, source.length);
+const sizesOf = (slices: Runs): number[] => slices.flatMap(([repeat, size]) => Array.from({ length: repeat }, () => size));
+const isRecipe = (entry: Recipe | FrameList): entry is Recipe => 'slices' in entry;
+
+/** Frames of an entry in index order: the listed hex, or the first header with index and payload length rewritten
+ * around consecutive slices of the receipt. The result must hash to the entry's framesSha256, so this helper cannot
+ * drift from the Python builder unnoticed. */
+function framesOf(entry: Recipe | FrameList): Uint8Array[] {
+  if (entry.frames) return entry.frames.map(unhex);
+  if (!isRecipe(entry) || !entry.firstHeader) throw new Error(`${entry.name}: neither frames nor a recipe`);
+  const receipt = receiptOf(entry.receipt);
+  const template = unhex(entry.firstHeader);
+  const frames: Uint8Array[] = [];
+  let offset = 0;
+  for (const [index, size] of sizesOf(entry.slices).entries()) {
+    const frame = new Uint8Array(HEADER + size);
+    frame.set(template);
+    const view = new DataView(frame.buffer);
+    view.setUint32(28, index);
+    view.setUint32(76, size);
+    frame.set(receipt.subarray(offset, offset + size), HEADER);
+    frames.push(frame);
+    offset += size;
+  }
+  if (offset !== receipt.length || sha256Hex(frames) !== entry.framesSha256) throw new Error(`${entry.name}: recipe does not reproduce the vector`);
+  return frames;
+}
+
+/** The same set in index order, reversed, and with odd indices first. */
+function arrangements(frames: readonly Uint8Array[]): [string, Uint8Array[]][] {
+  return [
+    ['index order', [...frames]],
+    ['reversed', [...frames].reverse()],
+    ['odd indices first', [...frames.filter((_, i) => i % 2 === 1), ...frames.filter((_, i) => i % 2 === 0)]],
+  ];
+}
+/** `first` bytes per frame, then a shorter or equal last frame: the only partition encodeReceiptFrames produces. */
+function greedyCapacity(sizes: readonly number[]): number | null {
+  const first = sizes[0]!;
+  const last = sizes[sizes.length - 1]!;
+  return sizes.slice(0, -1).every(size => size === first) && last <= first ? first : null;
+}
+async function outcome(frames: readonly Uint8Array[]): Promise<Uint8Array | null> {
+  try { return await recoverReceiptFrames(frames); } catch { return null; }
+}
+
+describe('independent golden vectors: the vector file as read here', () => {
+  it('names the protocol and holds all three kinds of entries', () => {
+    expect(vectors.schema).toBe('unaltered-ots-qr-independent-vectors/1');
+    expect(vectors.protocol).toBe('UNALTERED-OTS-QR/1');
+    expect(vectors.valid.length).toBeGreaterThanOrEqual(10);
+    expect(vectors.invalid.length).toBeGreaterThanOrEqual(30);
+    expect(vectors.unspecified.length).toBeGreaterThanOrEqual(3);
+  });
+  it('reproduces every recorded digest of receipts and frame sets', () => {
+    const recipes = [...vectors.valid, ...vectors.invalid.filter(isRecipe), ...vectors.unspecified.filter(isRecipe)];
+    for (const entry of recipes) {
+      const receipt = receiptOf(entry.receipt);
+      const frames = framesOf(entry);
+      expect(receipt.length, entry.name).toBe(entry.receiptLength);
+      expect(sha256Hex([receipt]), entry.name).toBe(entry.receiptSha256);
+      expect(frames.length, entry.name).toBe(entry.frameCount);
+      expect(sha256Hex(frames), entry.name).toBe(entry.framesSha256);
+      expect(frames.reduce((total, frame) => total + frame.length, 0), entry.name).toBe(entry.framesBytes);
+    }
+  }, 120_000);
+});
+
