+      }
+    }, 120_000);
+  }
+  it('refuses to encode a receipt that needs more than 4096 frames or is longer than 16,777,216 bytes', async () => {
+    const tooManyFrames = vectors.invalid.filter(isRecipe).find(entry => entry.name === 'frame-count-4097')!;
+    await expect(encodeReceiptFrames(receiptOf(tooManyFrames.receipt), HEADER + 1)).rejects.toBeInstanceOf(Error);
+    const tooLong = vectors.invalid.filter(isRecipe).find(entry => entry.name === 'original-length-16777217')!;
