--- /dev/null
+++ b/tests/qualification/robustness-corpus.spec.ts
@@ -0,0 +1,200 @@
+// Opt-in measurement of printed-certificate recovery from camera-like images. See robustness-README.md.
+//
+// Skipped unless UNALTERED_QR_ROBUSTNESS_PYTHON names a Python interpreter that has the pinned packages of
+// robustness-requirements.txt. CI runs this directory with Chromium and poppler-utils only, so there it is skipped.
+//
+// The in-app result is the path a user takes: the built app in Chromium, the image files given to the recovery
+// file input, decoded by the scan worker, frames reassembled, the downloaded receipt compared byte for byte.
+import { execFileSync, spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, rmSync, writeFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { expect, test, type Page } from '@playwright/test';
+import { archivalReceiptFixture } from '../helpers/archival-receipt';
+import { cspViolations, watchViolations } from '../e2e/helpers';
+
+const python = process.env.UNALTERED_QR_ROBUSTNESS_PYTHON ?? '';
+const work = resolve(process.env.UNALTERED_QR_ROBUSTNESS_DIR ?? 'test-results/qr-robustness');
+const label = process.env.UNALTERED_QR_ROBUSTNESS_LABEL ?? 'current';
+const seed = process.env.UNALTERED_QR_ROBUSTNESS_SEED ?? '20261111';
+const tool = resolve('tests/qualification/robustness-corpus.py');
+const MASTER_DPI = 600;
+/** The scan worker's per-image deadline (QR_SCAN_TIMEOUT_MS); an image that takes this long was terminated. */
+const IMAGE_DEADLINE_MS = 120_000;
+
+/** Certificates printed with the default (automatic) correction. Together they cover L, M, Q and H, the cover
+ * layout (two symbols) and a continuation page (three symbols), on both paper sizes. The expected plan is asserted,
+ * so a planner change cannot silently change what the corpus measures.
+ */
+const DOCUMENTS = [
+  { id: 'h2', payloadBytes: 400, paper: 'a4', version: 20, level: 'H', symbols: 2, symbolPages: 1 },
+  { id: 'q2', payloadBytes: 800, paper: 'letter', version: 22, level: 'Q', symbols: 2, symbolPages: 1 },
+  { id: 'l2', payloadBytes: 1700, paper: 'a4', version: 22, level: 'L', symbols: 2, symbolPages: 1 },
+  { id: 'm5', payloadBytes: 3000, paper: 'letter', version: 21, level: 'M', symbols: 5, symbolPages: 2 },
+] as const;
+/** Variant classes of the generator, in its order. Checked against the generated manifest. */
+const CLASSES = ['dpi', 'rotation', 'perspective', 'blur', 'jpeg', 'lighting', 'occlusion', 'combined'] as const;
+
+interface Variant { id: string; document: string; class: string; files: { path: string; sha256: string }[] }
+interface Manifest { seed: number; variants: Variant[] }
+type Outcome = 'recovered' | 'wrong' | 'rejected' | 'timeout';
+interface Measured { id: string; outcome: Outcome; ms: number; imageMs: number[] }
+
+const sha256 = (bytes: Uint8Array): string => createHash('sha256').update(bytes).digest('hex');
+const run = (args: string[]): string => execFileSync(python, ['-I', tool, ...args], { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
+const manifest = (): Manifest => JSON.parse(readFileSync(resolve(work, 'corpus/manifest.json'), 'utf8')) as Manifest;
+
+test.describe.configure({ mode: 'serial' });
+test.skip(!python, 'Opt-in corpus measurement: set UNALTERED_QR_ROBUSTNESS_PYTHON to a Python interpreter with ' +
+  'tests/qualification/robustness-requirements.txt installed (see tests/qualification/robustness-README.md).');
+
+test('stage 1: print certificates in Chromium and rasterize the master pages', async ({ page, browser }) => {
+  test.setTimeout(300_000);
+  const errors = await watchViolations(page);
+  // The cover prints the device clock. A fixed clock keeps the master pages identical between runs of one build.
+  await page.clock.setFixedTime(new Date('2026-11-11T00:00:00Z'));
+  const documents = [];
+  let build = 'unknown';
+  for (const doc of DOCUMENTS) {
+    const directory = resolve(work, 'base', doc.id);
+    rmSync(directory, { recursive: true, force: true }); mkdirSync(directory, { recursive: true });
+    const original = Buffer.from(archivalReceiptFixture(doc.payloadBytes));
+    writeFileSync(resolve(directory, 'original.ots'), original);
+    await page.goto('/Unaltered/#verify');
+    build = (await page.locator('#build-hash').textContent())?.trim() ?? 'unknown';
+    await page.getByLabel('Choose a .ots receipt for a QR certificate').setInputFiles({ name: `${doc.id}.ots`, mimeType: 'application/octet-stream', buffer: original });
+    await page.locator('.archival-import summary').click();
+    await expect(page.locator('.archival-import input[value="auto"]')).toBeChecked();
+    await page.locator(`.archival-import input[value="${doc.paper}"]`).check();
+    await page.getByRole('button', { name: 'Preview QR certificate', exact: true }).click();
+    await expect(page.locator('.archival-preview')).toBeVisible();
+    const labels = await page.locator('.unaltered-archival-symbol p:first-of-type').allTextContents();
+    expect(labels).toHaveLength(doc.symbols);
+    for (const text of labels) expect(text).toContain(`V${doc.version}; ${doc.version * 4 + 17} × ${doc.version * 4 + 17} modules; ECC ${doc.level};`);
+    const pages = await page.locator('.archival-page').count();
+    expect(pages).toBe(doc.symbolPages + 1);
+    const pdf = resolve(directory, 'certificate.pdf');
+    await page.pdf({ path: pdf, preferCSSPageSize: true, printBackground: true, displayHeaderFooter: false });
+    expect(Number(/^Pages:\s+(\d+)/m.exec(execFileSync('pdfinfo', [pdf], { encoding: 'utf8' }))?.[1])).toBe(pages);
+    // Symbol pages only: the last page is the recovery appendix and carries no QR data.
+    execFileSync('pdftoppm', ['-r', String(MASTER_DPI), '-gray', '-f', '1', '-l', String(doc.symbolPages), pdf, resolve(directory, 'raster')]);
+    const rasters = readdirSync(directory).filter(name => /^raster-\d+\.pgm$/.test(name)).sort();
+    expect(rasters).toHaveLength(doc.symbolPages);
+    rasters.forEach((name, index) => renameSync(resolve(directory, name), resolve(directory, `page-${index + 1}.pgm`)));
+    documents.push({ id: doc.id, paper: doc.paper, correction: 'auto', version: doc.version, level: doc.level, symbols: doc.symbols,
+      receiptBytes: original.length, receiptSha256: sha256(original), receipt: `${doc.id}/original.ots`,
+      pages: rasters.map((_, index) => `${doc.id}/page-${index + 1}.pgm`) });
+    await page.getByRole('button', { name: 'Close certificate preview' }).click();
+  }
+  const poppler = spawnSync('pdftoppm', ['-v'], { encoding: 'utf8' });
+  writeFileSync(resolve(work, 'base/base.json'), JSON.stringify({ masterDpi: MASTER_DPI, build, documents,
+    tools: { chromium: browser.version(), pdftoppm: /version (\S+)/.exec(`${poppler.stderr}${poppler.stdout}`)?.[1] ?? 'unknown' } }, null, 2) + '\n');
+  expect(await cspViolations(page)).toEqual([]);
+  expect(errors.list).toEqual([]);
+});
+
+test('stage 2: one seed generates the same corpus bytes twice', () => {
+  test.setTimeout(3_600_000);
+  for (const out of ['corpus', 'corpus-repeat']) {
+    rmSync(resolve(work, out), { recursive: true, force: true });
+    run(['generate', '--base', resolve(work, 'base'), '--out', resolve(work, out), '--seed', seed]);
+  }
+  const first = readFileSync(resolve(work, 'corpus/manifest.json'));
+  expect(sha256(readFileSync(resolve(work, 'corpus-repeat/manifest.json')))).toBe(sha256(first));
+  // The manifest lists the SHA-256 of every image; confirm that it describes the files that are on disk.
+  run(['check', '--corpus', resolve(work, 'corpus')]);
+  run(['check', '--corpus', resolve(work, 'corpus-repeat')]);
+  rmSync(resolve(work, 'corpus-repeat'), { recursive: true, force: true });
+  writeFileSync(resolve(work, 'determinism.json'), JSON.stringify({ generations: 2, identical: true, manifestSha256: sha256(first) }) + '\n');
+  expect(new Set(manifest().variants.map(variant => variant.class))).toEqual(new Set(CLASSES));
+});
+
+test('stage 3: third-party decoder on every variant', () => {
+  test.setTimeout(3_600_000);
+  run(['decode', '--base', resolve(work, 'base'), '--corpus', resolve(work, 'corpus'), '--out', resolve(work, 'third-party.json')]);
+  const results = JSON.parse(readFileSync(resolve(work, 'third-party.json'), 'utf8')) as { variants: { outcome: string }[] };
+  expect(results.variants).toHaveLength(manifest().variants.length);
+  // A receipt that passes both checksums but differs from the original would be a security finding.
+  expect(results.variants.filter(variant => variant.outcome === 'wrong')).toEqual([]);
+});
+
+type ScanLog = { __scan: [string, number][] };
+
+/** Opens the recovery panel offline and records every change of its status line with a page timestamp. */
+async function openRecovery(page: Page): Promise<string> {
+  await page.context().setOffline(false);
+  await page.goto('/Unaltered/#verify');
+  const build = (await page.locator('#build-hash').textContent())?.trim() ?? 'unknown';
+  await page.evaluate(() => {
+    const status = document.querySelector('.archival-recovery [role=status]')!;
+    (window as unknown as ScanLog).__scan = [];
+    new MutationObserver(() => { (window as unknown as ScanLog).__scan.push([status.textContent ?? '', performance.now()]); })
+      .observe(status, { childList: true, characterData: true, subtree: true });
+  });
+  await page.context().setOffline(true);
+  return build;
+}
+
+/** One variant through the recovery panel, exactly as a user would: choose the images, press the button, download. */
+async function recoverInApp(page: Page, files: string[], original: Buffer): Promise<Omit<Measured, 'id'> & { stuck: boolean }> {
+  await page.evaluate(() => { (window as unknown as ScanLog).__scan = []; });
+  const started = Date.now();
+  await page.getByLabel('Choose QR images or binary frame files').setInputFiles(files);
+  await page.getByRole('button', { name: 'Recover receipt from QR images' }).click();
+  const state = await page.waitForFunction(() => {
+    const root = document.querySelector('.archival-recovery');
+    if (root?.querySelector('a[download]')) return 'link';
+    return root?.querySelector('[role=status]')?.textContent?.startsWith('Recovery failed.') ? 'failed' : false;
+  }, null, { timeout: files.length * (IMAGE_DEADLINE_MS + 5_000) + 10_000, polling: 100 }).then(handle => handle.jsonValue(), () => 'stuck');
+  const ms = Date.now() - started;
+  const log = await page.evaluate(() => (window as unknown as ScanLog).__scan);
+  const scans = log.filter(([text]) => text.startsWith('Scanning input '));
+  const end = log.at(-1)?.[1] ?? 0;
+  const imageMs = scans.map(([, at], index) => Math.round((scans[index + 1]?.[1] ?? end) - at));
+  if (state === 'link') {
+    const [download] = await Promise.all([page.waitForEvent('download'), page.getByRole('link', { name: 'Download recovered .ots receipt' }).click()]);
+    const recovered = readFileSync((await download.path())!);
+    return { outcome: recovered.equals(original) ? 'recovered' : 'wrong', ms, imageMs, stuck: false };
+  }
+  // The app reports a terminated scan like any other unreadable image; only the time tells them apart.
+  const deadline = state === 'stuck' || imageMs.some(time => time >= IMAGE_DEADLINE_MS - 500);
+  return { outcome: deadline ? 'timeout' : 'rejected', ms, imageMs, stuck: state === 'stuck' };
+}
+
+for (const doc of DOCUMENTS) for (const group of CLASSES) {
+  test(`stage 4: in-app recovery of ${doc.id}/${group}`, async ({ page }) => {
+    const variants = manifest().variants.filter(variant => variant.document === doc.id && variant.class === group);
+    expect(variants.length).toBeGreaterThan(0);
+    test.setTimeout(60_000 + variants.reduce((sum, variant) => sum + variant.files.length * (IMAGE_DEADLINE_MS + 10_000), 0));
+    const errors = await watchViolations(page);
+    const original = readFileSync(resolve(work, 'base', doc.id, 'original.ots'));
+    const build = await openRecovery(page);
+    const measured: Measured[] = [];
+    for (const variant of variants) {
+      const { stuck, ...result } = await recoverInApp(page, variant.files.map(file => resolve(work, 'corpus', file.path)), original);
+      measured.push({ id: variant.id, ...result });
+      if (stuck) await openRecovery(page);
+    }
+    const directory = resolve(work, 'in-app', label); mkdirSync(directory, { recursive: true });
+    writeFileSync(resolve(directory, `${doc.id}-${group}.json`), JSON.stringify({ label, build, document: doc.id, class: group, variants: measured }, null, 1) + '\n');
+    console.log(`${doc.id}/${group}: ${measured.filter(item => item.outcome === 'recovered').length}/${measured.length} recovered in-app (${label}, build ${build})`);
+    // A download that differs from the original receipt would be a security finding, never a robustness number.
+    expect(measured.filter(item => item.outcome === 'wrong')).toEqual([]);
+    expect(await cspViolations(page)).toEqual([]);
+    expect(errors.list).toEqual([]);
+  });
+}
+
+test('stage 5: results summary', () => {
+  const out = resolve(work, 'qr-robustness.json');
+  const args = ['report', '--corpus', resolve(work, 'corpus'), '--third-party', resolve(work, 'third-party.json'),
+    '--in-app', resolve(work, 'in-app'), '--out', out];
+  if (existsSync(resolve(work, 'determinism.json'))) args.push('--determinism', resolve(work, 'determinism.json'));
+  console.log(run(args));
+  const summary = JSON.parse(readFileSync(out, 'utf8')) as
+    { totals: { tried: number; thirdParty: { wrong: number }; inApp: Record<string, { tried: number; wrong: number }> } };
+  expect(summary.totals.tried).toBe(manifest().variants.length);
+  expect(summary.totals.thirdParty.wrong).toBe(0);
+  expect(Object.keys(summary.totals.inApp).length).toBeGreaterThan(0);
+  for (const result of Object.values(summary.totals.inApp)) expect(result.wrong).toBe(0);
+});
